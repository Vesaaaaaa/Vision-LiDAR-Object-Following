<?xml version="1.0"?>
<sdf version="1.8">
  <model name="glass_bottle">
    <static>false</static>
    <link name="link">

      <!-- Inertial: ~0.4 kg glass bottle -->
      <inertial>
        <mass>0.4</mass>
        <pose>0 0 0.11 0 0 0</pose>
        <inertia>
          <ixx>0.0018</ixx>
          <iyy>0.0018</iyy>
          <izz>0.00018</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Simplified single-cylinder collision for stable physics -->
      <collision name="collision">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.036</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>10</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Bottle base (thicker glass at bottom) -->
      <visual name="base">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.036</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.35 0.15 0.85</ambient>
          <diffuse>0.2 0.45 0.2 0.85</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>

      <!-- Main body (green glass) -->
      <visual name="body">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.036</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.4 0.18 0.75</ambient>
          <diffuse>0.2 0.5 0.22 0.75</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>

      <!-- Shoulder (tapered transition to neck) -->
      <visual name="shoulder">
        <pose>0 0 0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.4 0.18 0.75</ambient>
          <diffuse>0.2 0.5 0.22 0.75</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>

      <!-- Neck -->
      <visual name="neck">
        <pose>0 0 0.215 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.014</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.4 0.18 0.75</ambient>
          <diffuse>0.2 0.5 0.22 0.75</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>

      <!-- Cap (metal/foil) -->
      <visual name="cap">
        <pose>0 0 0.235 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.65 0.65 0.65 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>

      <!-- Label (paper wrap around body) -->
      <visual name="label">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0362</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.82 0.7 1</ambient>
          <diffuse>0.95 0.9 0.75 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
