<?xml version="1.0"?>
<sdf version="1.8">
  <model name="metal_bin">
    <static>true</static>
    <link name="link">
      <!-- Main bin body: yellow/orange for metal recycling -->
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.45 0.45 0.65</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.325 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.45 0.65</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.55 0.05 1</ambient>
          <diffuse>0.9 0.6 0.05 1</diffuse>
          <specular>0.3 0.2 0.02 1</specular>
        </material>
      </visual>

      <!-- Lid -->
      <collision name="lid_collision">
        <pose>0 0 0.66 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="lid_visual">
        <pose>0 0 0.66 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.35 0.02 1</ambient>
          <diffuse>0.65 0.4 0.02 1</diffuse>
          <specular>0.2 0.1 0.01 1</specular>
        </material>
      </visual>

      <!-- Label strip: dark band with METAL text area -->
      <visual name="label_visual">
        <pose>0 0.228 0.42 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.005 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Slot opening on top for cans/metal items -->
      <visual name="slot_visual">
        <pose>0 0 0.682 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.06 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>

      <!-- Reinforcement ribs on sides -->
      <visual name="rib_front_visual">
        <pose>0 0.226 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.43 0.005 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.35 0.02 1</ambient>
          <diffuse>0.65 0.4 0.02 1</diffuse>
          <specular>0.2 0.1 0.01 1</specular>
        </material>
      </visual>
      <visual name="rib_back_visual">
        <pose>0 -0.226 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.43 0.005 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.35 0.02 1</ambient>
          <diffuse>0.65 0.4 0.02 1</diffuse>
          <specular>0.2 0.1 0.01 1</specular>
        </material>
      </visual>

      <inertial>
        <mass>4.5</mass>
        <inertia>
          <ixx>0.22</ixx>
          <iyy>0.22</iyy>
          <izz>0.18</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
