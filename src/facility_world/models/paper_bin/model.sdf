<?xml version="1.0"?>
<sdf version="1.8">
  <model name="paper_bin">
    <static>true</static>
    <link name="link">
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.45 0.35 0.55</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <!-- Main body -->
      <visual name="body_visual">
        <pose>0 0 0.275 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.35 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.5 0.0 1</ambient>
          <diffuse>0.0 0.6 0.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Lid -->
      <visual name="lid_visual">
        <pose>0 0 0.565 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.37 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.35 0.0 1</ambient>
          <diffuse>0.0 0.4 0.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Label strip -->
      <visual name="label_visual">
        <pose>0.226 0 0.275 0 0 0</pose>
        <geometry>
          <box>
            <size>0.002 0.25 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Slot opening on top -->
      <visual name="slot_visual">
        <pose>0 0 0.582 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.04 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.0 0.0 0.0 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
