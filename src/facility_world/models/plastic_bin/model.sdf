<?xml version="1.0"?>
<sdf version="1.8">
  <model name="plastic_bin">
    <static>true</static>
    <link name="link">
      <!-- Bin body -->
      <collision name="body_collision">
        <geometry>
          <box><size>0.45 0.35 0.55</size></box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box><size>0.45 0.35 0.55</size></box>
        </geometry>
        <material>
          <ambient>0.0 0.4 0.9 1</ambient>
          <diffuse>0.0 0.45 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Lid (slightly wider, sits on top) -->
      <collision name="lid_collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <box><size>0.47 0.37 0.04</size></box>
        </geometry>
      </collision>
      <visual name="lid_visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <box><size>0.47 0.37 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.0 0.3 0.75 1</ambient>
          <diffuse>0.0 0.35 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Label strip -->
      <visual name="label_visual">
        <pose>0.226 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>0.002 0.25 0.12</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.22</iyy><iyz>0</iyz>
          <izz>0.12</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
