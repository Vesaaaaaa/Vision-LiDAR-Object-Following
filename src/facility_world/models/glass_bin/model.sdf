<?xml version="1.0"?>
<sdf version="1.8">
  <model name="glass_bin">
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.08</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <!-- Main body -->
      <collision name="body_collision">
        <pose>0 0 0.28 0 0 0</pose>
        <geometry><box><size>0.38 0.38 0.56</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.28 0 0 0</pose>
        <geometry><box><size>0.38 0.38 0.56</size></box></geometry>
        <material>
          <ambient>0.45 0.28 0.05 1</ambient>
          <diffuse>0.55 0.35 0.08 1</diffuse>
          <specular>0.2 0.15 0.05 1</specular>
        </material>
      </visual>

      <!-- Lid -->
      <collision name="lid_collision">
        <pose>0 0 0.575 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.03</size></box></geometry>
      </collision>
      <visual name="lid_visual">
        <pose>0 0 0.575 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.03</size></box></geometry>
        <material>
          <ambient>0.30 0.18 0.03 1</ambient>
          <diffuse>0.38 0.22 0.04 1</diffuse>
          <specular>0.1 0.08 0.02 1</specular>
        </material>
      </visual>

      <!-- Circular opening on lid -->
      <visual name="opening_visual">
        <pose>0 0 0.592 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Label strip -->
      <visual name="label_visual">
        <pose>0.192 0 0.30 0 0 0</pose>
        <geometry><box><size>0.005 0.28 0.18</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>

      <!-- Reinforcement band top -->
      <visual name="band_top_visual">
        <pose>0 0 0.50 0 0 0</pose>
        <geometry><box><size>0.385 0.385 0.025</size></box></geometry>
        <material>
          <ambient>0.30 0.18 0.03 1</ambient>
          <diffuse>0.38 0.22 0.04 1</diffuse>
        </material>
      </visual>

      <!-- Reinforcement band bottom -->
      <visual name="band_bottom_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><box><size>0.385 0.385 0.025</size></box></geometry>
        <material>
          <ambient>0.30 0.18 0.03 1</ambient>
          <diffuse>0.38 0.22 0.04 1</diffuse>
        </material>
      </visual>

      <!-- Base -->
      <collision name="base_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.36 0.36 0.04</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.36 0.36 0.04</size></box></geometry>
        <material>
          <ambient>0.20 0.12 0.02 1</ambient>
          <diffuse>0.25 0.15 0.03 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
